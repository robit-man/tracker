{
  "manifest_version": 3,
  "name": "Tracker Distributed Storage",
  "version": "0.1.0",
  "description": "Persistent background contributor for Tracker global / room-based distributed storage. Keeps encrypted chunks available while the browser runs.",
  "minimum_chrome_version": "109",
  "browser_specific_settings": {
    "gecko": {
      "id": "tracker-storage@example.org",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tracker Storage"
  }
}
