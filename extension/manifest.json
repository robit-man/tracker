{
  "manifest_version": 3,
  "name": "Tracker Distributed Storage",
  "version": "0.2.0",
  "description": "Run Tracker's encrypted room and global storage providers in a supervised pinned tab while the browser is open.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "tracker-storage@robit-man.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://robit-man.github.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["protocol.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://robit-man.github.io/tracker/*", "http://localhost/*", "https://localhost/*", "http://127.0.0.1/*"],
      "js": ["protocol.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tracker Storage"
  }
}
